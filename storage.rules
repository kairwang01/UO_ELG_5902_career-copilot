rules_version = '2';

// Adopted from firebase-migration. Verified against the only two client upload
// paths in the app: components/Avatar.tsx -> avatars/{uid}/...
// and components/CompanyLogo.tsx -> company-logos/{uid}/...
// Server-generated assets (e.g. headshots) are written via the Admin SDK, which
// bypasses these rules. All other paths are denied by default.

service firebase.storage {
  match /b/{bucket}/o {

    // avatars/{userId}/{fileName}
    // Owner uploads/replaces their own avatar; any signed-in user may read
    // (needed to display profile photos).
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // max 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // company-logos/{userId}/{fileName}
    // Same rules as avatars — employer uploads their own logo.
    match /company-logos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // resumes/{userId}/{fileName}
    // Resume files are PII — ONLY the owner may read, upload, replace or delete
    // them. Employers never receive the file; talent discovery serves
    // server-extracted text via a Cloud Function (Admin SDK), not these objects.
    match /resumes/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (
                     // delete (request.resource is null on delete)
                     request.resource == null ||
                     (
                       request.resource.size < 10 * 1024 * 1024   // max 10 MB
                       && (
                         request.resource.contentType == 'application/pdf'
                         || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                         || request.resource.contentType == 'application/msword'
                         || request.resource.contentType.matches('text/.*')
                         || request.resource.contentType.matches('image/.*')
                         || request.resource.contentType == 'application/octet-stream'
                       )
                     )
                   );
    }

    // Everything else denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
