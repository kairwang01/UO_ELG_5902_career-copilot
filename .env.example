# .env.example
# Please copy this file and rename it to .env.local, then enter your Google AI Studio Gemini API Key below.
VITE_API_KEY=your_gemini_api_key_here

# Optional: override default model routing to avoid quota issues on Pro-tier models.
VITE_GEMINI_PRIMARY_MODEL=gemini-3-flash-preview
VITE_GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional: enable live Google Search grounding for Opportunity Finder.
# This can hit a separate Gemini tool/search quota even when normal Gemini calls work.
VITE_OPPORTUNITY_USE_GOOGLE_SEARCH=false

# Firebase Web App config.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
