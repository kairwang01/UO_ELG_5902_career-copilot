# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
#
# Production: these secrets are stored in Firebase Secret Manager (Jiaoyang).
# Local dev:  paste your personal key below.

GEMINI_API_KEY=your_gemini_api_key_here

# Model selection — change this line to switch between free and paid models.
# No code change needed; just restart the emulator after editing.
#
#   Free-tier key (local dev):  gemini-2.0-flash
#   Paid-tier key (testing / production): gemini-3-pro-preview
#
GEMINI_MODEL=gemini-2.0-flash

# KAIRLLM — OpenAI-compatible multi-model gateway ("auto" model). Selectable
# provider for paid+ users; free users stay on Gemini. Key stays server-side.
KAIRLLM_API_KEY=your_kairllm_api_key_here
KAIRLLM_BASE_URL=https://ai.gogosling.ca/v1

# Future provider keys (just add a row to functions/src/llm/models.ts to expose):
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
